package aed;

import java.util.*;

public class ListaEnlazada<T> implements Secuencia<T> {
    private T[] elementos;
    private int size;
    private Nodo primero; 
    private Nodo ultimo;


    private class Nodo {
     Nodo sig;
     Nodo ant;
     T valor; 
     

     public Nodo(T v) {
        this.valor = v;
     }

    }

    public ListaEnlazada() {
        primero = null; 
        ultimo = null;
        size = 0;
    }

    public int longitud() {
        return size;
        
    }

    public void agregarAdelante(T elem) {
        Nodo nuevo = new Nodo(elem);
        if (primero == null){
            nuevo.sig = null;
            nuevo.ant = null;
            primero = nuevo;
            ultimo = nuevo;
            size = 1; 
        }
        else {
            nuevo.sig = primero;
            primero = nuevo; 
            size ++;
        }

    }

    public void agregarAtras(T elem) {
        Nodo nuevo = new Nodo(elem);
        if (ultimo == null){
            nuevo.sig = null;
            nuevo.ant = null;
            primero = nuevo;
            ultimo = nuevo;
            size = 1;
        }
        else {
            ultimo.sig = nuevo;
            nuevo.ant = ultimo;
            ultimo = nuevo; 
            size ++;
        }
    }

    public T obtener(int i) {
        Nodo actual = primero;
        if (i<0 || i>= size){
            return null;
        }
        else {
            for (int j=0;j<i;j++)  {
               actual = actual.sig;
            }
            return actual.valor;
        }
    }

    public void eliminar(int i) {
        Nodo actual = primero; 
        Nodo desp = primero.sig; 
        Nodo antes = primero;
           
        if (size == 1) {
            primero = null;
            ultimo = null;
            size = 0; 
        }
        else { 
            if (i == (size-1)){
                antes = ultimo.ant; 
                antes.sig = null; 
                ultimo = antes; 
            }
            else {
                for (int j = 0;j < i; j++) {
                    antes = actual; 
                    actual = actual.sig;
                    desp = desp.sig;
                }
                if (i == 0) {
                    desp.ant = null; 
                    primero = desp; 
                 }
                else { 
                antes.sig = desp;
                desp.ant = antes;
            }
           }

        size --;
    }
    }

    public void modificarPosicion(int indice, T elem) {
        if (indice == 0){
            primero.valor = elem;
        }
        else {
            Nodo actual = primero;
            for (int j = 0; j< size; j++) {
                if (j == indice){
                    actual.valor = elem;
                } 
                else {
                    actual = actual.sig;
                }
            }
        }
    }

    public ListaEnlazada(ListaEnlazada<T> lista) {
        Nodo actual = lista.primero;
        while (actual != null){
            agregarAtras(actual.valor);
            actual = actual.sig;                      
        }

    }
    
    @Override
    public String toString() {
       String res = "[";
       res += obtener(0).toString();
       for (int j = 0; j < size; j++) {
        if (obtener(j) != null && j != 0){
            res += ", "; 
            res += obtener(j).toString();
        }
       }
       res += "]";
       return res;
    }

    private class ListaIterador implements Iterador<T> {
        int dedito = 0; 


        public boolean haySiguiente() {
	        return dedito < size;
        }
        
        public boolean hayAnterior() {
	        return dedito > 0;
        }

        public T siguiente() {
            int i = dedito;
            dedito = dedito + 1;
            return obtener(i);

        }
        

        public T anterior() {
            int i = dedito - 1;
            dedito --; 
            return obtener(i);
        }
    }

    public Iterador<T> iterador() {
            return new ListaIterador(); 
        }

}
