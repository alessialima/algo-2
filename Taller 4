// Todos los tipos de datos "Comparables" tienen el método compareTo()
// elem1.compareTo(elem2) devuelve un entero. Si es mayor a 0, entonces elem1 > elem2
public class ABB<T extends Comparable<T>> implements Conjunto<T> {
    private Nodo _raiz;
    private int _cardinal;
    private int _altura;

    private class Nodo {
        T valor;
        Nodo izq;
        Nodo der;
        Nodo padre;

        Nodo(T v) {
            valor = v;
            izq = null;
            der = null;
            padre = null;
        }

    }

    public ABB() {
        _raiz = null;
        _cardinal = 0;
        _altura = 0;
    }

    public int cardinal() {
        this._cardinal = 0;
    }

    public T minimo() {
        Nodo actual = _raiz;
        while(actual.izq != null){
            actual = actual.izq;
        }
        return actual.valor;
    }


    public T maximo() {
        Nodo actual = _raiz;
        while(actual.der != null){
            actual = actual.der;
        }
        return actual.valor;
    }

    public void insertar(T elem) {
        Nodo _nuevo = new Nodo(elem);
        Nodo _actual = _raiz;


        if (_raiz == null){
            _raiz = _nuevo;
            _raiz.valor = elem;
            _cardinal += 1;
        }
        else {
            if (!pertenece(elem)){
                if (elem.compareTo(_actual.valor)<0){
                    if (_actual.izq == null){
                        _nuevo.padre = _actual;
                        _actual.izq = _nuevo;
                    }
                    else {
                        _actual = _actual.izq;
                        // recursion como poronga empiezo otra vez
                    }
                }
                else {
                    if (_actual.der == null){
                        _nuevo.padre = _actual;
                        _actual.der = _nuevo;
                    }
                    else {
                        _actual = _actual.der;
                        // recursion como poronga empiezo otra vez
                    }             
                }
            }
        }
        
    }

    public boolean pertenece(T elem) {
        Nodo nuevo = new Nodo(elem);
        Nodo _actual = _raiz;
        if (_actual.valor == null){
            return false;
        }
       else {
        if (elem.compareTo(_actual.valor) == 0){
            return true;
        }
        else {
            while (_actual.izq != null || _actual.der != null){
                if (elem.compareTo(_actual.valor)<0){
                    _actual = _actual.izq;
                }
                else {
                    _actual = _actual.der;
                }
            }
            
            
        }
       }
    }

    public void eliminar(T elem) {
        if ( !pertenece(elem)){
            // no hago nada
        }
        else {
           
        }
    }

    public String toString() {
        throw new UnsupportedOperationException("No implementada aun");
    }

    private class ABB_Iterador implements Iterador<T> {
        private Nodo _actual = _raiz;

        public boolean haySiguiente() {
            if (_actual.der != null){
                return true;
            }
            else {
                return false;
            }
        }

        public T siguiente() {
            _actual = _actual.der; 
            return _actual.valor;
        }
    }

    public Iterador<T> iterador() {
        return new ABB_Iterador();
    }

}
