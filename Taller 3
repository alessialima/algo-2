    private class ListaIterador implements Iterador<T> {
    	int dedito;
        Iterador(){
            dedito = 0;
        }

        public boolean haySiguiente() {
	        return dedito != size;
        }
        
        public boolean hayAnterior() {
	        return dedito != 0;
        }

        public T siguiente() {
	        int i = dedito; 
            dedito = dedito + 1;
            return elementos[i];
        }
        

        public T anterior() {
	        int i = dedito;
            dedito = dedito - 1;
            return elementos[i];
        }
    }

    public Iterador<T> iterador() {
	    return new Iterador();
