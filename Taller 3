package aed;

import java.util.*;

public class ListaEnlazada<T> implements Secuencia<T> {
    private T[] elementos;
    private int size;
    private Nodo primero; 
    private Nodo ultimo;

    private class Nodo {
     Nodo sig;
     Nodo ant;
     T valor; 

     public Nodo(T v) {
        this.valor = v;
     }

    }

    public ListaEnlazada() {
        primero = null; 
    }

    public int longitud() {
        return size;
        
    }

    public void agregarAdelante(T elem) {
        Nodo nuevo = new Nodo(elem);
        nuevo.sig = primero;
        nuevo.ant = null;
        primero = nuevo; 
        size ++;
    }

    public void agregarAtras(T elem) {
        Nodo nuevo = new Nodo(elem);
        nuevo.ant = ultimo;
        nuevo.sig = null;
        size ++;
    }

    public T obtener(int i) {
        return elemento[i];
    }

    public void eliminar(int i) {
        Nodo actual = primero;
        Nodo prev = primero;
        for (int j = 0; j < i; j++) {
         prev = actual;
         actual = actual.sig;
        }
        if (i == 0) {
         primero = actual.sig;
        } 
        else {
         prev.sig = actual.sig;
        }
    }

    public void modificarPosicion(int indice, T elem) {
        throw new UnsupportedOperationException("No implementada aun");
    }

    public ListaEnlazada(ListaEnlazada<T> lista) {
        Nodo actual = lista.primero;
        while (actual != null){
            agregarAtras(actual.valor);
            actual = actual.sig;                      
        }

    }
    
    @Override
    public String toString() {
       String word = "";
       for (int j = 0; j < size; j++) {
        String elemento_string = T.toString(elemento[j]);
        String word += elemento_string; 
       }
       return word;
    }

    private class ListaIterador implements Iterador<T> {
    	int dedito;
        Iterador() { 
            dedito = 0;
        }

        public boolean haySiguiente() {
	        return dedito != size;
        }
        
        public boolean hayAnterior() {
	        return dedito != 0;
        }

        public T siguiente() {
	        int i = dedito; 
            dedito = dedito + 1;
            return elementos[i];
        }
        

        public T anterior() {
	        int i = dedito;
            dedito = dedito - 1;
            return elementos[i];
        }
    }

    public Iterador<T> iterador() {
	    return new Iterador();
    }

}
