package aed;

import java.util.*;

public class ListaEnlazada<T> implements Secuencia<T> {
    private T[] elementos;
    private int size;
    private Nodo primero; 
    private Nodo ultimo;

    private class Nodo {
     Nodo sig;
     Nodo ant;
     T valor; 
     

     public Nodo(T v) {
        this.valor = v;
     }

    }

    public ListaEnlazada() {
        primero = null; 
        ultimo = null;
        size = 0;
    }

    public int longitud() {
        return size;
        
    }

    public void agregarAdelante(T elem) {
        Nodo nuevo = new Nodo(elem);
        if (primero == null){
            nuevo.sig = null;
            nuevo.ant = null;
            primero = nuevo;
            ultimo = nuevo;
            size = 1; 
        }
        else {
            nuevo.sig = primero;
            primero = nuevo; 
            size ++;
        }

    }

    public void agregarAtras(T elem) {
        Nodo nuevo = new Nodo(elem);
        if (ultimo == null){
            nuevo.sig = null;
            nuevo.ant = null;
            primero = nuevo;
            ultimo = nuevo;
            size = 1;
        }
        else {
            ultimo.sig = nuevo;
            nuevo.ant = ultimo;
            ultimo = nuevo; 
            size ++;
        }
    }

    public T obtener(int i) {
        Nodo actual = primero;
        if (i<0 || i>= size){
            return null;
        }
        else {
            for (int j=0;j<i;j++)  {
               actual = actual.sig;
            }
            return actual.valor;
        }
    }

    public void eliminar(int i) {
        Nodo actual = primero; 
        Nodo desp = primero.sig; 
        Nodo antes = primero;
           
        if (size == 1) {
            primero = null;
            ultimo = null;
            size = 0; 
        }
        else { 
            if (i == (size-1)){
                antes = ultimo.ant; 
                antes.sig = null; 
                ultimo = antes; 
            }
            else {
                for (int j = 0;j < i; j++) {
                    antes = actual; 
                    actual = actual.sig;
                    desp = desp.sig;
                }
                if (i == 0) {
                    desp.ant = null; 
                    primero = desp; 
                 }
                else { 
                antes.sig = desp;
                desp.ant = antes;
            }
           }

        size --;
    }
    }
